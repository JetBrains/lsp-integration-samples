<idea-plugin>
    <id>com.intellij.experimental.bicep-lsp</id>
    <name>Bicep LSP</name>
    <vendor url="https://jetbrains.com/">JetBrains</vendor>

    <description><![CDATA[
        <b>Experimental</b>. Bicep language support through the Bicep language server.
    ]]></description>

    <dependencies>
        <plugin id="com.intellij.modules.platform"/>
        <module name="intellij.platform.lsp"/>
        <module name="intellij.platform.lsp.impl"/>
    </dependencies>

    <resource-bundle>messages.BicepBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="textmate" extensions="bicep"/>
        <fileIconProvider implementation="org.jetbrains.lsp.samples.bicep.BicepFileIconProvider"/>
        <platform.lsp.integrationProvider implementation="org.jetbrains.lsp.samples.bicep.BicepLspIntegrationProvider"/>
        <platform.lsp.serverSettingsProvider implementation="org.jetbrains.lsp.samples.bicep.BicepLspServerSettingsProvider"/>
    </extensions>
</idea-plugin>
